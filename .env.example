# Copy to .env only if you want local overrides. Never commit real values.
SERPAPI_API_KEY=
GOOGLE_CACHE_PATH=

# OpenAI-compatible model provider used by the full configurations
API_KEY=EMPTY
BASE_URL=http://localhost:8000/v1

# Optional graph/vector backends
NEO4J_URI=bolt://localhost:7687
NEO4J_SERVER_URI=http://localhost:7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

MILVUS_HOST=localhost
MILVUS_PORT=19530

# Local paths (relative to the repository root by default)
LOG_DIR=./logs
PLOT_DIR=./plots
